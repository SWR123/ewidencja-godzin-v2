# PRZYKŁADOWY PLIK ZMIENNYCH ŚRODOWISKOWYCH DLA DOCKER
# Skopiuj ten plik jako '.env' i uzupełnij wartości

# === BAZA DANYCH POSTGRESQL ===
POSTGRES_USER=ewidencja
POSTGRES_PASSWORD=TwojeHasloDoBAZY123!  # ZMIEŃ NA BEZPIECZNE HASŁO!
POSTGRES_DB=ewidencja_db

# === NEXTAUTH (AUTORYZACJA) ===
# Wygeneruj losowy sekret - możesz użyć: openssl rand -base64 32
NEXTAUTH_SECRET=WYGENERUJ_LOSOWY_SEKRET_TUTAJ_32_ZNAKI

# URL aplikacji - jeśli instalujesz na serwerze, zmień na adres IP lub domenę
# Przykłady:
# NEXTAUTH_URL=http://192.168.1.100:3000  (dla sieci lokalnej)
# NEXTAUTH_URL=https://twoja-domena.pl  (dla domeny publicznej)
NEXTAUTH_URL=http://localhost:3000

# === UWAGI ===
# 1. ZMIEŃ WSZYSTKIE HASŁA NA BEZPIECZNE!
# 2. NIE UDOSTĘPNIAJ tego pliku publicznie
# 3. Dla NEXTAUTH_SECRET użyj naprawdę losowego ciągu znaków